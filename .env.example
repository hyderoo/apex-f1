# ---- Supabase (optional: app runs in demo mode without these) ----
# Browser-safe project URL and publishable (anon) key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret. Never expose to the browser. Used by ingestion/sync jobs.
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenF1 ----
# Historical sessions are available without a key. A paid OpenF1 subscription
# key enables true real-time data during live sessions.
# Without it, in-progress sessions are labelled DELAYED.
OPENF1_API_KEY=

# ---- Ingestion cron ----
# Shared secret protecting /api/cron/sync. Set the same value in Vercel Cron.
CRON_SECRET=

# ---- App ----
# Public base URL used for share links and ICS files (e.g. https://apex-f1.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Web Push (session notifications). Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
